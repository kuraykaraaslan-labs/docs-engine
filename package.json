{
  "name": "@kuraykaraaslan/docs",
  "version": "0.1.0",
  "description": "A Docusaurus-like documentation engine for Next.js App Router: markdown content, a typed config for navbar, sidebars and footer, and a fence-plugin registry.",
  "license": "0BSD",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraykaraaslan-labs/docs-engine.git"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "!src/__fixtures__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./ui": "./src/ui/index.ts",
    "./next": "./src/next/index.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vendor:kui": "node scripts/vendor-kui.mjs",
    "check:kui-vendor": "node scripts/vendor-kui.mjs --check",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "clsx": "^2.1.1",
    "hast-util-to-html": "^9.0.5",
    "mermaid": "^11.17.2",
    "next-themes": "^0.4.4",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "tailwind-merge": "^2.5.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "site"
  ],
  "homepage": "https://github.com/kuraykaraaslan-labs/docs-engine#readme",
  "bugs": {
    "url": "https://github.com/kuraykaraaslan-labs/docs-engine/issues"
  }
}
